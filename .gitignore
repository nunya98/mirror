# ---------------------------------------------------------------------------
# Secrets — never commit
# ---------------------------------------------------------------------------
mirror.env
.env
*.env
!.env.example
wpa_supplicant.conf
*.pem
*.key
*.p12

# ---------------------------------------------------------------------------
# Media — large binaries, and the scare clips may not be yours to redistribute.
# The tree keeps the directories with .gitkeep files so a fresh clone has the
# layout; run tools/encode.sh to regenerate black.mp4.
# ---------------------------------------------------------------------------
media/calm/*
media/scares/*
!media/calm/.gitkeep
!media/scares/.gitkeep
*.mp4
*.mkv
*.mov
*.m4v
*.webm
*.wav
*.mp3

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtualenvs — the core is stdlib-only, but keep this in case one appears
env/
venv/
.venv/
ENV/
virtualenv/

# Test / coverage / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# ---------------------------------------------------------------------------
# Runtime artefacts — these live on tmpfs under systemd, but a manual run
# can drop them in the tree.
# ---------------------------------------------------------------------------
*.sock
*.pid
*.log
logs/
run/

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------------
# Local overrides — keep the committed mirror.toml canonical, let operators
# keep private tweaks out of the repo.
# ---------------------------------------------------------------------------
mirror.local.toml
mirror.toml.bak
*.orig
*.rej

# ---------------------------------------------------------------------------
# Scratch output from tools/encode.sh
# ---------------------------------------------------------------------------
tools/out/
*.raw.mp4

