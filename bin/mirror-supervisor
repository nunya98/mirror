#!/usr/bin/env python3
"""Launcher: puts <root>/src on sys.path, then runs the supervisor."""
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "src"))

from mirror.supervisor import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())

